# Never commit real secrets. Paste local values into .env.
# Managed model choices shown in Lab. Zhipu is the default.
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.7-flash

# Volcano Ark also accepts ARK_API_KEY as an alias for DOUBAO_API_KEY.
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-0-mini-260215

# Original V4 Flash choice and the legacy server settings endpoint.
# COMPANY_DEEPSEEK_API_KEY remains accepted as a server-only key alias.
DEEPSEEK_API_KEY=
COMPANY_DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional browser-direct mode. Any VITE_* value is embedded into the browser bundle.
# Do not put a private API key here unless you accept that visitors can see and reuse it.
VITE_ZHIPU_API_KEY=
VITE_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VITE_ZHIPU_MODEL=glm-4.7-flash
VITE_DOUBAO_API_KEY=
VITE_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VITE_DOUBAO_MODEL=doubao-seed-2-0-mini-260215
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com
VITE_DEEPSEEK_MODEL=deepseek-v4-flash
VITE_GITHUB_REPO_URL=https://github.com/yanghaoleng/FakeChat
VITE_FEEDBACK_WECHAT_ID=
VITE_ALIPAY_QR_CODE_URL=
# Optional Fish Audio TTS proxy key. Keep this server-side.
FISH_AUDIO_API_KEY=

# Required for voice generation/rendering. The API only uses the VoxCPM-compatible worker.
# It no longer falls back to macOS `say` or synthetic tones.
VOXCPM_WORKER_URL=

API_PORT=8787
PUBLIC_API_ORIGIN=http://127.0.0.1:8787
